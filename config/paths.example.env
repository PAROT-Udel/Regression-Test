# Template only. The harness does not load this file.
# Copy to paths.env (gitignored). Env vars override paths.env.
# Roots below are relative to the suite directory.

CETUS=/path/to/The-Cetus-Project/bin/cetus
CLANG_FORMAT=clang-format
GCC=gcc
DIFF=diff
CPP=cpp

# Vendored in benchmarks/. See benchmarks/README.md for the download sources.
POLYBENCH_ROOT=benchmarks/polybench-c-4.2.1-beta
NPB_SER_ROOT=benchmarks/NPB3.3-SER-C

# NPB OpenMP C is not vendored. Set NPB_OMP_ROOT only to run --benchmark-suite npb-omp.
# NPB_OMP_ROOT=/path/to/NPB3.3-OMP-C
