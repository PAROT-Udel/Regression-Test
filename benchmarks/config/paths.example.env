# Copy to paths.env (gitignored) or export these in your shell.
# Env vars always win over paths.env.

CETUS=/mnt/d/workspace/cetus/The-Cetus-Project/bin/cetus
CLANG_FORMAT=clang-format
GCC=gcc
DIFF=diff
CPP=cpp

# Vanilla trees (default for Cetus 3.0 release confidence)
POLYBENCH_ROOT=/mnt/d/workspace/ud-masters/benchmarks/polybench-c-4.2
